# Copiar a .env.local y completar

# PostgreSQL (ej. Neon, Supabase o local)
DATABASE_URL=postgres://usuario:password@localhost:5432/todopack

# Better Auth
BETTER_AUTH_SECRET=generar-con-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Vercel Blob (imágenes de productos y comprobantes)
BLOB_READ_WRITE_TOKEN=

# Opcional: tamaño de lote para scripts/import-product-images.mjs
# IMAGE_BATCH=50
