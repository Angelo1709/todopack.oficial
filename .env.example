# Copiar a .env.local y completar. En Railway se cargan en Variables del servicio.

# PostgreSQL. En Railway: referenciar ${{Postgres.DATABASE_URL}}.
# Local sin instalar Postgres: `pnpm db:local` y usar la URL de abajo.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# Better Auth. Generar el secreto con: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL pública del sitio (dominio principal, sin "/" al final). En Railway se puede omitir: se usa
# RAILWAY_PUBLIC_DOMAIN. Con dominio propio cargarla (p. ej. https://todopackalcorta.com): sin ella no
# anda el login en el dominio nuevo, y con ella la dirección de Railway redirige al dominio propio.
BETTER_AUTH_URL=http://localhost:3000

# Emails con rol superadmin (gestiona usuarios). Se aplica al registrarse y al iniciar sesión.
SUPERADMIN_EMAILS=
# Emails que quedan como admin al registrarse (separados por coma). Opcional: el superadmin
# también puede crear admins desde /admin/usuarios.
ADMIN_EMAILS=

# Opcional: si está, las imágenes encontradas se copian a Vercel Blob; si no, se guarda la URL original.
# BLOB_READ_WRITE_TOKEN=

# Stock de Gestion.mdb. Clave exclusiva de al menos 32 caracteres (nunca NEXT_PUBLIC_*).
STOCK_SYNC_TOKEN=
STOCK_SYNC_SOURCE_ID=gestion-principal
# Activar después de revisar vínculos: oculta stock cero, negativo y desconocido.
STOCK_SYNC_REQUIRED=false

# Opcional: métricas con PostHog (docs/metricas-posthog.md). Sin token no se manda nada.
# Se leen al compilar: después de cargarlas hace falta un deploy nuevo.
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_...
# NEXT_PUBLIC_POSTHOG_REGION=us
# Opcional: visitas y embudo en /admin/metricas. Clave personal de PostHog con permiso "Query: Read"
# (secreta, sólo servidor) y el número de proyecto. Ver docs/metricas-posthog.md, sección 6.
# POSTHOG_PERSONAL_API_KEY=phx_...
# POSTHOG_PROJECT_ID=
