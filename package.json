{
  "name": "todopack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node --env-file-if-exists=.env.local scripts/migrate.mjs && next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed-products.mjs",
    "make-admin": "node --env-file-if-exists=.env.local scripts/make-admin.mjs",
    "db:local": "pglite-server --db=.pglite --port=5433 --max-connections=10",
    "check": "node scripts/check-pack.mjs && node scripts/check-pricing.mjs && node scripts/check-route.mjs && node scripts/check-sync.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/blob": "^2.8.0",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.2",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.16.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "radix-ui": "1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.0",
    "typescript": "5.7.3"
  }
}
